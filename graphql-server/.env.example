# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins ("*" allows any origin - not recommended in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Enable schema introspection + Apollo Sandbox landing page (defaults to true outside production).
GRAPHQL_INTROSPECTION=true

# ---- Database (local Docker MySQL is exposed on host port 3307) ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=employee_app
DB_PASSWORD=change_me_app_password
DB_NAME=employee_db
DB_CONNECTION_LIMIT=10
# false | true (verify against system CAs) | rds (verify against the Amazon RDS CA bundle)
DB_SSL=false

# ---- Migrations ----
# Directory containing migrations/ and seeds/ (defaults to ../database when run from graphql-server/).
# DATABASE_DIR=../database

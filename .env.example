# =====================================================================
# Docker Compose configuration. Copy to .env and change the passwords:
#   cp .env.example .env
# Never commit .env. On AWS these values come from the ECS task definition
# and AWS Secrets Manager instead of this file.
# =====================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=employee_db
DB_USER=employee_app
DB_PASSWORD=change_me_app_password

# ---- GraphQL server ----
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Enables schema introspection + Apollo Sandbox at /graphql (disable in real production).
GRAPHQL_INTROSPECTION=true
# Load sample employees on first start (applied once per database).
SEED_DATABASE=true

# ---- Frontend ----
# GraphQL endpoint as seen from the user's browser.
FRONTEND_GRAPHQL_URL=http://localhost:4000/graphql

# ---- Host port mappings ----
FRONTEND_HOST_PORT=8080
API_HOST_PORT=4000
# 3307 avoids clashing with a locally installed MySQL on 3306.
MYSQL_HOST_PORT=3307
